FROM ubuntu:22.04 AS builder
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git pkg-config ca-certificates \
    gcc-10 g++-10 gcc-10-plugin-dev \
    odb libodb-dev libodb-pgsql-dev libodb-boost-dev \
    libboost-dev libboost-date-time-dev \
    libc6-dev libpq-dev \
    nlohmann-json3-dev \
    && rm -rf /var/lib/apt/lists/*

ENV CC=/usr/local/bin/gcc
ENV CXX=/usr/local/bin/g++
RUN ln -sf /usr/bin/gcc-10 /usr/local/bin/gcc \
    && ln -sf /usr/bin/g++-10 /usr/local/bin/g++

WORKDIR /src
COPY . /src

# Build only the server target, skip client to avoid ftxui FetchContent overhead
RUN cmake -S . -B build -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_C_COMPILER=/usr/local/bin/gcc \
    -DCMAKE_CXX_COMPILER=/usr/local/bin/g++ \
    -DBUILD_CLIENT=OFF \
    && cmake --build build --target GymgymServer -j$(nproc)

FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 ca-certificates libstdc++6 \
    libodb-2.4 libodb-pgsql-2.4 libodb-boost-2.4 \
    libboost-date-time1.74.0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /src/build/server/GymgymServer /usr/local/bin/GymgymServer
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/GymgymServer"]